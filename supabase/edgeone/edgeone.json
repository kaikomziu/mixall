        }
      ]
    },
    {
      "source": "/ogp/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/data/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=30"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
